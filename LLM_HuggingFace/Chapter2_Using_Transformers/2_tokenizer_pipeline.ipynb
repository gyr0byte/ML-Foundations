     "output_type": "stream",
     "text": [
      "['i', 'love', 'programming', 'in', 'python', '!']\n"
     ]
    }
   ],
   "source": [
    "tokenzier = AutoTokenizer.from_pretrained(\"bert-base-uncased\")\n",
    "tokens = tokenzier.tokenize(\"I love programming in Python!\")\n",
    "print(tokens)"
